# ── Auto Research · secrets (copy to .env, never commit) ──────────────────

# InsForge
INSFORGE_PROJECT_ID=53f5746b-2434-4f35-8ea5-74022c4749ec
INSFORGE_URL=                      # project API base URL
INSFORGE_ANON_KEY=                 # browser-safe (web/)
INSFORGE_SERVICE_KEY=              # edge fn + orchestrator only (full write)
INSFORGE_USER_API_KEY=             # for the CLI: npx @insforge/cli login --user-api-key …

# Daytona (orchestration sandboxes)
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=us

# Apify (scraping)
APIFY_TOKEN=

# Anthropic (reasoning)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# ── Frontend (web/) — Vite needs the VITE_ prefix ────────────────────────
VITE_INSFORGE_URL=
VITE_INSFORGE_ANON_KEY=
