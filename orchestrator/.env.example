# Orchestrator env — injected by the start-run edge function into the Daytona
# sandbox, or loaded from here for local dev (npm run dev).

# Run context (set per run; for local dev provide your own)
RUN_ID=
QUERY=Which AI-agent businesses should we build right now?
MODE=market                       # academic | market
PARAMS={}                         # JSON overrides for tunables (see src/config.ts)

# InsForge (server-side admin key — full write access)
INSFORGE_URL=https://xtv932cy.us-east.insforge.app
INSFORGE_SERVICE_KEY=             # the project api_key (ik_...) from .insforge/project.json

# LLM via InsForge AI gateway (OpenRouter)
OPENROUTER_API_KEY=
LLM_MODEL=anthropic/claude-sonnet-4.5   # confirm exact slug in OpenRouter catalog / InsForge dashboard

# Apify (scraping)
APIFY_TOKEN=
